#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    macros {
        u_a_acute: u_a_acute {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_ALT>,
                <&macro_tap>,
                <&kp KP_N0 &kp KP_N2 &kp KP_N2 &kp KP_N5>,
                <&macro_release>,
                <&kp LEFT_ALT>;

            label = "U_A_ACUTE";
        };

        u_e_acute: u_e_acute {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_ALT>,
                <&macro_tap>,
                <&kp KP_N0 &kp KP_N2 &kp KP_N3 &kp KP_N3>,
                <&macro_release>,
                <&kp LEFT_ALT>;

            label = "U_E_ACUTE";
        };

        u_i_acute: u_i_acute {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_ALT>,
                <&macro_tap>,
                <&kp KP_N0 &kp KP_N2 &kp KP_N3 &kp KP_N7>,
                <&macro_release>,
                <&kp LEFT_ALT>;

            label = "U_I_ACUTE";
        };

        u_o_acute: u_o_acute {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_ALT>,
                <&macro_tap>,
                <&kp KP_N0 &kp KP_N2 &kp KP_N4 &kp KP_N3>,
                <&macro_release>,
                <&kp LEFT_ALT>;

            label = "U_O_ACUTE";
        };

        u_u_acute: u_u_acute {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_ALT>,
                <&macro_tap>,
                <&kp KP_N0 &kp KP_N2 &kp KP_N5 &kp KP_N0>,
                <&macro_release>,
                <&kp LEFT_ALT>;

            label = "U_U_ACUTE";
        };

        m001: m001 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(P) &kp A>;
            label = "M001";
        };

        m002: m002 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp N1 &kp N7 &kp N0 &kp N8>;
            label = "M002";
        };

        m003: m003 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp N2 &kp N4>;
            label = "M003";
        };

        m004: m004 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp N2 &kp N0 &kp N2 &kp N4>;
            label = "M004";
        };

        m005: m005 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp D &kp U &kp AT>;
            label = "M005";
        };

        aspas_duplas: aspas_duplas {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_ALT>,
                <&macro_tap>,
                <&kp KP_N0 &kp KP_N0 &kp KP_N3 &kp KP_N4>,
                <&macro_release>,
                <&kp LEFT_ALT>,
                <&macro_press>,
                <&kp LEFT_ALT>,
                <&macro_tap>,
                <&kp KP_N0 &kp KP_N0 &kp KP_N3 &kp KP_N4>,
                <&macro_release>,
                <&kp LEFT_ALT>,
                <&macro_tap>,
                <&kp LEFT_ARROW>;

            label = "ASPAS_DUPLAS";
        };

        passpad1: passpad1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(P) &kp A &kp D &kp U>;
            label = "PASSPAD1";
        };

        passpad5: passpad5 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp AT_SIGN>;
            label = "PASSPAD5";
        };

        passpad2: passpad2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp KP_N0 &kp N4 &kp N1 &kp N4>;
            label = "PASSPAD2";
        };

        passpad4: passpad4 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp N2 &kp N7 &kp N3 &kp N0>;
            label = "PASSPAD4";
        };

        passpad3: passpad3 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp N1 &kp N5 &kp N9 &kp N9>;
            label = "PASSPAD3";
        };

        aspas_simples: aspas_simples {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_ALT>,
                <&macro_tap>,
                <&kp KP_N0 &kp KP_N0 &kp KP_N3 &kp KP_N9>,
                <&macro_release>,
                <&kp LEFT_ALT>,
                <&macro_press>,
                <&kp LEFT_ALT>,
                <&macro_tap>,
                <&kp KP_N0 &kp KP_N0 &kp KP_N3 &kp KP_N9>,
                <&macro_release>,
                <&kp LEFT_ALT>,
                <&macro_tap>,
                <&kp LEFT_ARROW>;

            label = "ASPAS_SIMPLES";
        };

        ip_001: ip_001 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp N1 &kp N9 &kp N2 &kp DOT &kp N1 &kp N6 &kp N8 &kp DOT &kp N0 &kp DOT &kp N1>;
            label = "IP_001";
        };
    };

    combos {
        compatible = "zmk,combos";

        ip_001-combo {
            bindings = <&ip_001>;
            key-positions = <20 22 1>;
            timeout-ms = <100>;
            layers = <0>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer0 {
            display-name = "PaDu";
            bindings = <
&kp ESCAPE     &kp N1  &kp N2            &kp N3         &kp N4  &kp N5                              &kp N6  &kp N7  &kp N8         &kp N9   &kp N0    &kp MINUS
&aspas_duplas  &kp Q   &kp W             &kp E          &kp R   &kp T                               &kp Y   &kp U   &kp I          &kp O    &kp P     &kp EQUAL
&kp TAB        &kp A   &kp S             &kp D          &kp F   &kp G                               &kp H   &kp J   &kp K          &kp L    &kp SEMI  &kp SQT
&kp LSHFT      &kp Z   &kp X             &kp C          &kp V   &kp B   &kp C_MUTE    &kp CAPSLOCK  &kp N   &kp M   &kp COMMA      &kp DOT  &kp FSLH  &kp RA(W)
                       &kp LEFT_CONTROL  &kp RIGHT_ALT  &mo 1   &mo 2   &kp RET       &kp SPACE     &mo 3   &mo 4   &kp BACKSPACE  &kp DEL
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOL_DN C_VOL_UP>,
                <&inc_dec_kp PAGE_UP PAGE_DOWN>;
        };

        L1 {
            display-name = "Function";
            bindings = <
&trans          &kp F1     &kp F2        &kp F3         &kp F4    &kp F5                                                 &kp F6           &kp F7           &kp F8     &kp F9     &kp F10   &kp F11
&aspas_simples  &kp N1     &kp QUESTION  &kp N3         &kp N4    &kp N5                                                 &kp KP_N8        &kp KP_N8        &kp KP_N9  &kp N9     &kp N0    &kp F12
&trans          &kp EXCL   &kp AT        &kp HASH       &kp DLLR  &kp PRCNT                                              &kp KP_N4        &kp KP_N5        &kp KP_N6  &kp LPAR   &kp RPAR  &kp PIPE
&trans          &kp EQUAL  &kp MINUS     &kp PLUS       &kp LBRC  &kp RBRC   &trans    &rgb_ug RGB_COLOR_HSB(24,100,81)  &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_N3  &kp COLON  &kp BSLH  &kp RA(Q)
                           &trans        &kp RIGHT_ALT  &trans    &trans     &trans    &trans                            &trans           &kp KP_NUMBER_0  &trans     &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        layer2 {
            display-name = "Arrow";
            bindings = <
&bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                                              &none      &none     &none     &none      &none    &none
&trans      &kp INS       &kp PSCRN     &kp K_CMENU   &trans        &trans                                                    &kp PG_UP  &trans    &kp UP    &trans     &trans   &trans
&trans      &kp LALT      &kp LCTRL     &kp LSHFT     &trans        &kp CAPS                                                  &kp PG_DN  &kp LEFT  &kp DOWN  &kp RIGHT  &kp DEL  &kp BSPC
&trans      &kp K_UNDO    &kp K_CUT     &kp K_COPY    &kp K_PASTE   &trans        &trans    &rgb_ug RGB_COLOR_HSB(24,100,50)  &trans     &trans    &trans    &trans     &trans   &trans
                          &trans        &trans        &trans        &trans        &trans    &trans                            &trans     &trans    &trans    &trans
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOL_DN C_VOL_UP>,
                <&inc_dec_kp LEFT_ARROW RIGHT_ARROW>;
        };

        layer3 {
            display-name = "Pass";
            bindings = <
&rgb_ug RGB_ON   &passpad1  &passpad2       &passpad3       &passpad4        &passpad5                    &none   &none   &none   &none   &none   &none
&rgb_ug RGB_OFF  &trans     &trans          &kp UP_ARROW    &trans           &trans                       &trans  &trans  &trans  &trans  &trans  &trans
&sys_reset       &trans     &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &trans                       &trans  &trans  &trans  &trans  &trans  &trans
&trans           &trans     &trans          &trans          &trans           &trans     &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
                            &trans          &trans          &trans           &to 0      &trans    &trans  &trans  &trans  &trans  &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP>;
        };

        layer_4 {
            bindings = <
&trans  &m001       &m002   &m003       &m004   &m005                     &trans  &trans      &trans      &trans      &trans  &trans
&trans  &trans      &trans  &u_e_acute  &trans  &trans                    &trans  &u_u_acute  &u_i_acute  &u_o_acute  &trans  &trans
&trans  &u_a_acute  &trans  &trans      &trans  &trans                    &trans  &trans      &trans      &trans      &trans  &trans
&trans  &trans      &trans  &trans      &trans  &trans  &trans    &trans  &trans  &trans      &trans      &trans      &trans  &trans
                    &trans  &trans      &trans  &trans  &trans    &trans  &trans  &trans      &trans      &trans
            >;

            label = "Acento";
        };
    };
};
